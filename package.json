{
  "name": "antares-extension",
  "displayName": "Antares — Anti-Scam Scanner for Solana",
  "version": "1.0.0",
  "description": "Antares scans Solana tokens in real time and detects rug pulls, honeypots, bundlers and chart manipulation — directly in your browser.",
  "author": "COMEALAMAISONGROUPE",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/node": "^3.2.0",
    "eslint": "^8.56.0",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "notifications"
    ],
    "host_permissions": [
      "https://*/*",
      "https://fonts.googleapis.com/*",
      "https://fonts.gstatic.com/*"
    ]
  }
}
