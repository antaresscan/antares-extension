{
  "name": "antares-extension",
  "displayName": "Antares — Anti-Scam Scanner for Solana",
  "version": "1.4.0",
  "description": "Real-time Solana token scanner. 7-layer scoring on every token page. Free unlimited scans, Pro for power users.",
  "author": "COMEALAMAISONGROUPE",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-bundle.mjs && node scripts/smoke-options.mjs",
    "overlay:check": "node scripts/overlay-alignment.mjs",
    "replay": "vitest run __tests__/replay",
    "replay:full": "node scripts/replay/run.mjs full",
    "replay:update": "node scripts/replay/run.mjs update",
    "replay:verify": "node scripts/replay/run.mjs verify",
    "replay:capture": "tsx scripts/replay/capture.ts"
  },
  "dependencies": {
    "@sentry/browser": "^10.76.2",
    "@sentry/node": "10.76.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^5.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.14.5",
    "plasmo": "0.90.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "manifest": {
    "permissions": [
      "storage",
      "notifications",
      "alarms",
      "tabs"
    ],
    "host_permissions": [
      "https://app.telemetry.io/*",
      "https://axiom.trade/*",
      "https://birdeye.so/*",
      "https://dexscreener.com/*",
      "https://gmgn.ai/*",
      "https://photon-sol.tinyastro.io/*",
      "https://pump.fun/*",
      "https://www.geckoterminal.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'"
    }
  }
}
