{
  "name": "antares-extension",
  "displayName": "Antares — Anti-Scam Scanner for Solana",
  "version": "1.0.0",
  "description": "Antares scans Solana tokens in real time and detects rug pulls, honeypots, bundlers and chart manipulation — directly in your browser.",
  "author": "COMEALAMAISONGROUPE",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/browser": "^10.43.0",
    "@sentry/node": "^10.45.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "plasmo": "0.90.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/node": "^3.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^8.56.0",
    "prettier": "3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "notifications",
      "activeTab",
      "alarms"
    ],
    "host_permissions": [
      "https://dexscreener.com/*",
      "https://birdeye.so/*",
      "https://raydium.io/*",
      "https://pump.fun/*",
      "https://jup.ag/*",
      "https://solscan.io/*",
      "https://defined.fi/*",
      "https://www.geckoterminal.com/*",
      "https://photon-sol.tinyastro.io/*",
      "https://neo.bullx.io/*",
      "https://antares-extension.vercel.app/*",
      "https://fonts.googleapis.com/*",
      "https://fonts.gstatic.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'"
    }
  }
}
