{
  "name": "antares-extension",
  "displayName": "Antares — Anti-Scam Scanner for Solana",
  "version": "1.3.10",
  "description": "Real-time Solana token scanner. 7-layer scoring on every token page. Free unlimited scans, Pro for power users.",
  "author": "COMEALAMAISONGROUPE",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-bundle.mjs",
    "corpus:capture": "tsx scripts/corpus-capture.ts",
    "corpus:refresh": "tsx scripts/corpus-capture.ts --refresh",
    "corpus:discover": "tsx scripts/corpus-discover.ts",
    "test:corpus": "vitest run __tests__/backtest"
  },
  "dependencies": {
    "@sentry/browser": "^10.52.0",
    "@sentry/node": "^10.52.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.38.0",
    "plasmo": "0.90.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "0.1.42",
    "@types/node": "20.19.40",
    "@types/react": "^19.2.15",
    "@types/node": "20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.8",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "manifest": {
    "permissions": [
      "storage",
      "notifications",
      "activeTab",
      "alarms",
      "tabs"
    ],
    "host_permissions": [
      "https://app.telemetry.io/*",
      "https://axiom.trade/*",
      "https://birdeye.so/*",
      "https://dexscreener.com/*",
      "https://gmgn.ai/*",
      "https://photon-sol.tinyastro.io/*",
      "https://pump.fun/*",
      "https://www.geckoterminal.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'"
    }
  }
}
