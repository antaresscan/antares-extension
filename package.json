{
  "name": "antares-extension",
  "displayName": "Antares \u2014 Anti-Scam Scanner for Solana",
  "version": "1.0.0",
  "description": "Antares scans Solana tokens in real time and detects rug pulls, honeypots, bundlers and chart manipulation \u2014 directly in your browser.",
  "author": "COMEALAMAISONGROUPE",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/browser": "^10.43.0",
    "@sentry/node": "^10.45.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "plasmo": "0.90.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.1.38",
    "@types/node": "20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "notifications",
      "activeTab",
      "alarms"
    ],
    "host_permissions": [
      "https://app.telemetry.io/*",
      "https://axiom.trade/*",
      "https://birdeye.so/*",
      "https://dexscreener.com/*",
      "https://gmgn.ai/*",
      "https://photon-sol.tinyastro.io/*",
      "https://pump.fun/*",
      "https://www.geckoterminal.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'"
    }
  }
}
