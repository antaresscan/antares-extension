# Antares Extension — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Required — Helius RPC API key (https://dev.helius.xyz)
HELIUS_API_KEY=

# Required — Upstash Redis (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — Solscan Pro API key (https://pro-api.solscan.io)
# Without this key, Solscan Pro endpoints will be skipped (layer L5 may be unavailable)
SOLSCAN_API_KEY=

# Optional — Sentry DSN for error monitoring (https://sentry.io)
# Leave empty to disable Sentry
SENTRY_DSN=

# Required — API key for Chrome extension authentication
# Chrome extensions must send this key via X-Antares-Key header
ANTARES_API_KEY=

# Optional — Override the global API timeout in milliseconds (default: 9000)
# VERCEL_TIMEOUT=9000

# Optional — Gemini API key for AI-powered scan summaries (https://ai.google.dev)
# Leave empty to disable AI summaries (scans will still work)
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
