# Antares Extension — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# See README.md → "Environment variables" for the per-var description.

# ──────────────────────────────────────────────────────────────────────────────
# CORE (required)
# ──────────────────────────────────────────────────────────────────────────────

# Helius RPC + Enhanced Transactions API key (https://dev.helius.xyz)
HELIUS_API_KEY=

# Upstash Redis (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chrome extension auth — Chrome extensions must send this via X-Antares-Key
ANTARES_API_KEY=

# Session signing key (32+ chars). Generate with: openssl rand -hex 32
# If unset, account.ts derives a fallback from UPSTASH_REDIS_REST_TOKEN —
# acceptable for bootstrap but set explicitly ASAP. See the doc-block at
# the top of api/_lib/account.ts for the rationale.
SESSION_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# CRYPTO CHECKOUT (required for paid tiers — Pro / Yearly)
# ──────────────────────────────────────────────────────────────────────────────

# NOWPayments dashboard → Settings → API keys
NOWPAYMENTS_API_KEY=

# NOWPayments IPN secret from the same dashboard.
# Used to HMAC-SHA512 verify incoming webhook payloads — REQUIRED for
# auth/nowpayments-ipn to accept any event. Without it, the webhook
# fails closed (401) and no licenses are issued.
NOWPAYMENTS_IPN_SECRET=

# API host — used to build the NOWPayments IPN callback URL.
# Defaults to https://antares-extension.vercel.app
ANTARES_PUBLIC_BASE_URL=

# Marketing-site host — used to build the post-payment success / cancel
# redirects. account.html lives on the website, NOT on the API host —
# without this set, NOWPayments redirects buyers to the API host's
# /account.html which 404s. Defaults to https://antares-website.vercel.app
ANTARES_WEBSITE_URL=

# Price overrides — leave unset to use defaults.
ANTARES_PRICE_MONTHLY_USD=24.99
ANTARES_PRICE_YEARLY_USD=149.99

# Optional success / cancel URL overrides.
# ANTARES_SUCCESS_URL defaults to ${WEBSITE}/account.html?ref=<reference>
# ANTARES_CANCEL_URL  defaults to ${WEBSITE}/account.html?cancelled=1
# ANTARES_SUCCESS_URL=
# ANTARES_CANCEL_URL=

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ──────────────────────────────────────────────────────────────────────────────

# Solscan Pro API key (https://pro-api.solscan.io)
# Without this, Solscan Pro endpoints are skipped (layer L5 may be unavailable).
SOLSCAN_API_KEY=

# Sentry DSN for error monitoring (https://sentry.io). Free tier (5K
# events / month) is more than enough at current production volumes.
# Wired across the entire payment + auth critical path — see
# api/_lib/sentry.ts and README.md → "Observability".
SENTRY_DSN=

# Gemini API key for AI-powered scan summaries (https://ai.google.dev).
# Leave empty to disable AI summaries — scans still work without it.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Override the per-fetch global timeout in milliseconds (default 9000).
# VERCEL_TIMEOUT=9000

# ──────────────────────────────────────────────────────────────────────────────
# DEV / FOUNDER GRANTS (optional)
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated emails that get a free Yearly licence auto-issued on
# signup/login. No-op if unset. Keep out of source control; setting these
# in Vercel env vars only is the intended posture (see api/_lib/account.ts
# getDevLifetimeEmails docblock).
# DEV_LIFETIME_EMAILS=

# Comma-separated emails that get a free Pro 30-day licence auto-issued.
# Same shape as DEV_LIFETIME_EMAILS — operators can list the same address
# in both to get both licences attached to their /account view.
# DEV_PRO_EMAILS=
