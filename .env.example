# Antares Extension — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# See README.md → "Environment variables" for the per-var description.

# ──────────────────────────────────────────────────────────────────────────────
# CORE (required)
# ──────────────────────────────────────────────────────────────────────────────

# Helius RPC + Enhanced Transactions API key (https://dev.helius.xyz)
HELIUS_API_KEY=

# Upstash Redis (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel crons (api/cron-check-payments, api/health?watch=limited) and the usage report of /api/health: Vercel sends
# "Authorization: Bearer <CRON_SECRET>" on every scheduled call (api/_lib/cron-auth.ts). Without it nothing is authorised:
# the crons are refused and a pending payment is only confirmed by the NOWPayments IPN. Generate with: openssl rand -hex 32
# (There is no ANTARES_API_KEY any more: no code reads it, the extension sends no X-Antares-Key.)
CRON_SECRET=

# Session signing key (32+ chars). Generate with: openssl rand -hex 32
# If unset, account.ts derives a fallback from UPSTASH_REDIS_REST_TOKEN —
# acceptable for bootstrap but set explicitly ASAP. See the doc-block at
# the top of api/_lib/account.ts for the rationale.
SESSION_SECRET=

# E-mail proof (audit A-01). An account owns the licences of its e-mail only once the owner has confirmed it: sign-up e-mails a link
# (api/_lib/mailer.ts, through Resend). Resend dashboard → API Keys. Without the key, sign-ups answer 503 and create nothing.
# The sender's domain (antaresscan.com) must be verified in Resend (SPF + DKIM DNS records) or Resend refuses every send.
RESEND_API_KEY=
# Sender, default "Antares <contact@antaresscan.com>":
# MAIL_FROM=
# Where the link of the e-mail points (the page verify.html), default https://antares-extension.vercel.app. Set it on a preview to test there:
# VERIFY_LINK_BASE=

# ──────────────────────────────────────────────────────────────────────────────
# CRYPTO CHECKOUT (required for paid tiers — Pro / Yearly)
# ──────────────────────────────────────────────────────────────────────────────

# NOWPayments dashboard → Settings → API keys
NOWPAYMENTS_API_KEY=

# NOWPayments IPN secret from the same dashboard.
# Used to HMAC-SHA512 verify incoming webhook payloads — REQUIRED for
# auth/nowpayments-ipn to accept any event. Without it, the webhook
# fails closed (401) and no licenses are issued.
NOWPAYMENTS_IPN_SECRET=

# API host — used to build the NOWPayments IPN callback URL.
# Defaults to https://antares-extension.vercel.app
ANTARES_PUBLIC_BASE_URL=

# Marketing-site host — used to build the post-payment success / cancel
# redirects. account.html lives on the website, NOT on the API host —
# without this set, NOWPayments redirects buyers to the API host's
# /account.html which 404s. Defaults to https://antares-website.vercel.app
ANTARES_WEBSITE_URL=

# Price overrides — leave unset to use defaults.
ANTARES_PRICE_MONTHLY_USD=24.99
ANTARES_PRICE_YEARLY_USD=149.99

# Optional success / cancel URL overrides.
# ANTARES_SUCCESS_URL defaults to ${WEBSITE}/account.html?ref=<reference>
# ANTARES_CANCEL_URL  defaults to ${WEBSITE}/account.html?cancelled=1
# ANTARES_SUCCESS_URL=
# ANTARES_CANCEL_URL=

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ──────────────────────────────────────────────────────────────────────────────

# Solscan Pro API key (https://pro-api.solscan.io)
# Without this, Solscan Pro endpoints are skipped (layer L5 may be unavailable).
SOLSCAN_API_KEY=
# Optional. Jupiter's organic score (api/_lib/jupiter.ts) works without a key (30 requests a minute); a free key from developers.jup.ag/portal doubles it (60).
JUPITER_API_KEY=

# GoPlus credentials (https://gopluslabs.io): app key + app secret, exchanged for a short-lived access token (see
# api/_lib/goplus-auth.ts). BOTH are required; each goes in its own variable (the key is NOT the variable name).
# Without them, or if the exchange fails, scans fall back to the anonymous tier: nothing breaks, you only get less headroom.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Sentry DSN for error monitoring (https://sentry.io). Free tier (5K
# events / month) is more than enough at current production volumes.
# Wired across the entire payment + auth critical path — see
# api/_lib/sentry.ts and README.md → "Observability".
SENTRY_DSN=

# Gemini API key for AI-powered scan summaries (https://ai.google.dev).
# Leave empty to disable AI summaries — scans still work without it.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Override the scan's global time budget in milliseconds (default 24000, api/scan.ts GLOBAL_TIMEOUT_MS; the function's own
# limit is 25 s, vercel.json maxDuration).
# VERCEL_TIMEOUT=24000

# Insider Watch (/api/graph) is Pro only and costs ~120 Helius credits per mint nobody asked for yet (~430 with the activity
# feed). This is the most requests it answers in a UTC day, for the whole service; past it, 429 until 00:00 UTC. Default 500.
# GRAPH_GLOBAL_PER_DAY=500

# Key of the references that replace e-mail addresses in the logs (api/_lib/log-ref.ts): 16 characters or more. Optional. Without it the key is
# derived from SESSION_SECRET, so rotating SESSION_SECRET changes every reference; set this one to keep them stable across a rotation.
# LOG_PEPPER=

# ──────────────────────────────────────────────────────────────────────────────
# DEV / FOUNDER GRANTS (optional)
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated install ids allowed to force a tier from the Options page's "Dev mode" (X-Antares-Dev-Tier header,
# api/_lib/user.ts). Unset: nobody can.
# DEV_PRO_INSTALLS=

# Server log level: info | warn | error. Default: warn in production, info elsewhere; an unknown value falls back to that
# default and is reported once (api/_lib/logger.ts).
# LOG_LEVEL=

# Emergency switch of "Limited data" (api/_lib/helpers.ts limitedDataEnabled). off, 0, false or no: no scan is marked any more, the
# engine's verdict is shown even during a Helius outage (a scan made then is still cached 30 s only). Unset: on. Redeploy after a change.
# LIMITED_DATA=

# Comma-separated emails that get a free Yearly licence auto-issued on
# signup/login. No-op if unset. Keep out of source control; setting these
# in Vercel env vars only is the intended posture (see api/_lib/account.ts
# getDevLifetimeEmails docblock).
# DEV_LIFETIME_EMAILS=

# Comma-separated emails that get a free Pro 30-day licence auto-issued.
# Same shape as DEV_LIFETIME_EMAILS — operators can list the same address
# in both to get both licences attached to their /account view.
# DEV_PRO_EMAILS=

# Extra chrome-extension IDs allowed to call the API (comma-separated).
# The official Chrome Web Store ID is built in (api/_lib/middleware.ts);
# list here only an unpacked dev build or a second store listing. Each ID
# is 32 characters from a-p; malformed entries are ignored. Every other
# extension origin gets no CORS headers at all.
# ALLOWED_EXTENSION_IDS=
